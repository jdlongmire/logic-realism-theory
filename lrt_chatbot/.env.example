# Gemini API key (required)
GEMINI_API_KEY=your-api-key-here

# Optional overrides
# LRT_EMBEDDING_MODEL=text-embedding-004
# LRT_LLM_MODEL=gemini-2.5-pro

# Authentication (recommended for production)
# When set, users must log in before accessing the chatbot
# LRT_CHATBOT_USERNAME=lrt
# LRT_CHATBOT_PASSWORD=a-strong-password-here
